{
  "name": "PortfolioSnapshot",
  "type": "object",
  "properties": {
    "total_value": {
      "type": "number",
      "description": "Total portfolio value at snapshot time"
    },
    "snapshot_date": {
      "type": "string",
      "description": "ISO date string (YYYY-MM-DD) for this snapshot"
    }
  },
  "required": [
    "total_value",
    "snapshot_date"
  ]
}