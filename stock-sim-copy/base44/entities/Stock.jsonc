{
  "name": "Stock",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Stock ticker symbol"
    },
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "price": {
      "type": "number",
      "description": "Current price per share"
    },
    "previous_price": {
      "type": "number",
      "description": "Previous price for change calculation"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "platinum",
        "prestige"
      ],
      "default": "free",
      "description": "Stock tier"
    },
    "color": {
      "type": "string",
      "description": "Brand color hex for the stock"
    },
    "sector": {
      "type": "string",
      "description": "Industry sector"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "symbol",
    "name",
    "price",
    "tier"
  ]
}