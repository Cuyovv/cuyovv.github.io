{
  "name": "Portfolio",
  "type": "object",
  "properties": {
    "cash_balance": {
      "type": "number",
      "default": 10000,
      "description": "Available cash to trade"
    },
    "holdings": {
      "type": "array",
      "description": "Current stock holdings",
      "items": {
        "type": "object",
        "properties": {
          "stock_symbol": {
            "type": "string"
          },
          "shares": {
            "type": "number"
          },
          "avg_buy_price": {
            "type": "number"
          }
        }
      }
    },
    "unlocked_stocks": {
      "type": "array",
      "description": "List of premium/platinum/prestige stock symbols the user has unlocked",
      "items": {
        "type": "string"
      }
    },
    "prestige_level": {
      "type": "number",
      "default": 0,
      "description": "How many times the player has prestiged"
    },
    "owned_items": {
      "type": "array",
      "description": "IDs of purchased cosmetic shop items",
      "items": {
        "type": "string"
      }
    },
    "achievement_ids": {
      "type": "array",
      "description": "IDs of earned achievements",
      "items": {
        "type": "string"
      }
    },
    "active_background": {
      "type": "string",
      "description": "Currently equipped background item ID"
    },
    "active_title": {
      "type": "string",
      "description": "Currently equipped title item ID"
    },
    "total_value": {
      "type": "number",
      "description": "Total portfolio value (cash + holdings)"
    },
    "player_name": {
      "type": "string",
      "description": "Display name for leaderboard"
    },
    "theme": {
      "type": "string",
      "description": "The player's personal UI theme identifier",
      "enum": [
        "emerald",
        "cyan",
        "violet",
        "amber",
        "rose",
        "indigo",
        "orange",
        "teal",
        "lime",
        "sky",
        "pink",
        "gold",
        "red"
      ]
    }
  },
  "required": [
    "cash_balance"
  ]
}